{
  "name": "dsh-session-export",
  "version": "0.2.0",
  "description": "Export a DeepSeek Harness session transcript as Markdown, HTML, or JSON with per-turn and per-event-type selection",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "session",
    "export",
    "transcript",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navms/dsh-session-export.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "install:plugin": "node scripts/install.mjs",
    "uninstall:plugin": "node scripts/install.mjs --uninstall",
    "install:plugin:github": "node scripts/install.mjs --github"
  }
}
